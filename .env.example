# Gemini through Vertex AI with your local `gcloud auth application-default login`
VERTEX_PROJECT_ID=your-project-id
VERTEX_LOCATION=global
VERTEX_USE_ADC=1
# Hosted on Vercel, keyless: the workload identity provider and the service account to act as
# VERTEX_WORKLOAD_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# VERTEX_SERVICE_ACCOUNT_EMAIL=<account>@<project>.iam.gserviceaccount.com
# Or an AI Studio key instead (wins if set)
# GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_TEXT_MODEL=gemini-3.8-flash
# USD per generated image, for the cost counter
IMAGE_PRICE_USD=0.134
# Hosted demo: paid images per visitor and for the whole site, per day
# DEMO_DAILY_IMAGES=30
# DEMO_SITE_DAILY_IMAGES=300
